{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nutrii.fit/schema/ban_list.schema.json",
  "title": "BanListEntry",
  "description": "An entry on the nutrii ban list",
  "type": "object",
  "required": ["food_id", "reason"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "food_id": { "type": "string", "format": "uuid" },
    "reason": { "type": "string" },
    "lethal_dose_mg": { "type": ["number", "null"] },
    "is_conditionally_safe": { "type": "boolean", "default": false },
    "safe_condition": { "type": ["string", "null"] },
    "regulatory_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["banned", "restricted", "permitted", "under_review"] },
          "regulation": { "type": ["string", "null"] },
          "agency": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] },
          "max_ppm": { "type": ["number", "null"] }
        },
        "required": ["status"]
      }
    }
  },
  "additionalProperties": false
}
