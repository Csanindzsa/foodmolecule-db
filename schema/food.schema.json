{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nutrii.app/schema/food.schema.json",
  "title": "Food",
  "description": "A food ingredient in the nutrii database",
  "type": "object",
  "required": ["name", "category"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "maxLength": 255 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "category": { "type": "string", "maxLength": 100 },
    "origin": { "type": ["string", "null"], "maxLength": 255 },
    "overall_safety_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "health_index": { "type": "integer", "minimum": 0, "maximum": 100 },
    "ban_listed": { "type": "boolean", "default": false },
    "image_url": { "type": ["string", "null"], "format": "uri" },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "ingested_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "usda_fdc_id": { "type": ["integer", "null"] },
        "foodb_id": { "type": ["string", "null"] }
      }
    },
    "ai_guide_version": { "type": ["integer", "null"] },
    "last_analyzed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
