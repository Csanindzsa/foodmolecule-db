{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nutrii.app/schema/ai_guide.schema.json",
  "title": "IngredientAIGuide",
  "description": "An AI agent instruction guide for a specific food ingredient or molecule",
  "type": "object",
  "required": ["guide_markdown", "version"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "food_id": { "type": ["string", "null"], "format": "uuid" },
    "molecule_id": { "type": ["string", "null"], "format": "uuid" },
    "guide_markdown": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "generated_by": { "type": ["string", "null"], "maxLength": 100 },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
