# nutrii — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────
# For local development (Docker Compose):
DATABASE_URL=postgresql://nutrii_user:nutrii_dev_password@localhost:5432/nutrii
# For production (Supabase pooler — used by Django app):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For Django migrations (direct connection — bypasses PgBouncer):
DATABASE_URL_DIRECT=postgresql://nutrii_user:nutrii_dev_password@localhost:5432/nutrii

# Local Docker PG credentials (must match docker-compose.yml):
POSTGRES_DB=nutrii
POSTGRES_USER=nutrii_user
POSTGRES_PASSWORD=nutrii_dev_password

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:nutrii_redis_dev@localhost:6379/0
REDIS_PASSWORD=nutrii_redis_dev

# ─── Supabase ─────────────────────────────────────────────────────
# Leave empty for local development (uses Docker PG directly)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── MinIO (local S3-compatible storage) ──────────────────────────
MINIO_ROOT_USER=nutrii_minio_user
MINIO_ROOT_PASSWORD=nutrii_minio_dev_password
MINIO_ENDPOINT=http://localhost:9000

# ─── AI / OpenRouter ──────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── MeiliSearch ──────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=nutrii_meili_dev_key

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ─── PubMed / NCBI ────────────────────────────────────────────────
# Optional but recommended to increase rate limits (free at ncbi.nlm.nih.gov)
NCBI_API_KEY=
NCBI_EMAIL=your@email.com

# ─── USDA FoodData Central ────────────────────────────────────────
# Get your free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=

# ─── Google Cloud (OCR) ───────────────────────────────────────────
# Optional — only needed for Phase 13 (OCR scanner)
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
