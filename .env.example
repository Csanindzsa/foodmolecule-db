# nutrii — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────
# For local dev, set DATABASE_URL, or leave empty to auto-construct
# from SUPABASE_URL + SUPABASE_DB_PASSWORD.

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database password (from Supabase project creation) — only needed
# if DATABASE_URL is not set:
SUPABASE_DB_PASSWORD=

# ─── AI providers ─────────────────────────────────────────────────
# OpenRouter primary key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional comma-separated extra OpenRouter keys tried after OPENROUTER_API_KEY.
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenCode Go fallback keys: https://opencode.ai/auth
# Use OPENCODE_GO_API_KEYS for multiple comma-separated keys.
OPENCODE_GO_API_KEY=
OPENCODE_GO_API_KEYS=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek/deepseek-v4-flash

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Web frontend ─────────────────────────────────────────────────
# Public API base URL consumed by Vite builds. VITE_API_URL wins when
# both names are set; VITE_API_BASE_URL is accepted for older deploy docs.
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=

# ─── Mobile app ───────────────────────────────────────────────────
# Public API base URL consumed by Expo builds. Defaults locally in code
# to Android emulator 10.0.2.2 or localhost for iOS simulator/web.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ─── PubMed / NCBI ────────────────────────────────────────────────
# Optional but recommended to increase rate limits (free at ncbi.nlm.nih.gov)
NCBI_API_KEY=
NCBI_EMAIL=your@email.com

# ─── Image enrichment ─────────────────────────────────────────────
# Brave Search API key, used only by scripts/fetch_images.py for food photos.
BRAVE_API_KEY=
SUPABASE_IMAGE_BUCKET=food-images

# ─── USDA FoodData Central ────────────────────────────────────────
# Get your free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=
# Overnight ingestion defaults: paginated USDA search + batched /foods detail fetch.
USDA_LIMIT=5000
USDA_PAGE_SIZE=200
USDA_CANDIDATE_MULTIPLIER=2
USDA_MAX_PAGES_PER_QUERY=10
USDA_DETAIL_BATCH_SIZE=50
